#!/bin/bash
# QEMU for RISC-V from the Ubuntu packages unpacked under tools/qemu (no system install).
here=$(cd "$(dirname "$0")" && pwd)
export LD_LIBRARY_PATH=$here/qemu/usr/lib/x86_64-linux-gnu${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}
exec "$here/qemu/usr/bin/qemu-system-riscv64" -L "$here/qemu/usr/share/qemu" "$@"
