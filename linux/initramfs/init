#!/bin/sh
# fable64 bring-up initramfs: Debian busybox-static, nothing else.
export PATH=/bin:/sbin:/usr/bin:/usr/sbin
/bin/busybox mount -t devtmpfs devtmpfs /dev
exec </dev/console >/dev/console 2>&1
/bin/busybox --install -s
mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t tmpfs tmpfs /tmp
mount -t tmpfs tmpfs /run
mkdir -p /dev/pts && mount -t devpts devpts /dev/pts
hostname -F /etc/hostname
ip link set lo up

echo
echo "=============================================================="
echo " fable64 initramfs  -  $(uname -s -r -m)"
echo " $(busybox | head -n 1)"
echo " cpu : $(sed -n 's/^isa[^:]*: //p' /proc/cpuinfo | head -n 1)   mmu: $(sed -n 's/^mmu[^:]*: //p' /proc/cpuinfo | head -n 1)"
echo " mem : $(sed -n 's/^MemTotal: *//p' /proc/meminfo)"
echo " cmd : $(cat /proc/cmdline)"
echo "=============================================================="
echo

# Shell on the console with job control; respawn if it exits.
while :; do
    setsid cttyhack /bin/sh
    echo "shell exited - respawning (use 'poweroff -f' or 'reboot -f' to stop)"
done
